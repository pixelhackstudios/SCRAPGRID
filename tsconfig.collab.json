{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist-collab",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["collab/**/*.ts", "game/**/*.ts", "tests/**/*.ts"]
}
