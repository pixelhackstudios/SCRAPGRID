{
  "name": "scrapgrid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:collab && tsc -b && vite build",
    "build:collab": "tsc -p tsconfig.collab.json",
    "collab": "npm run build:collab --silent && node dist-collab/collab/cli.js",
    "lint": "oxlint",
    "test": "npm run build:collab --silent && node --test dist-collab/tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
