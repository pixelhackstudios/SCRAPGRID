{
  "name": "scrapgrid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run collabd",
    "build": "npm run build:collab && tsc -b && vite build",
    "build:collab": "tsc -p tsconfig.collab.json",
    "collab": "npm run build:collab --silent && node dist-collab/collab/cli.js",
    "collabd": "npm run build:collab --silent && node --enable-source-maps dist-collab/collab/collabd.js",
    "lint": "oxlint",
    "test": "npm run build:collab --silent && node --test dist-collab/tests/*.test.js",
    "preview": "vite preview",
    "start": "node --enable-source-maps dist-collab/collab/collabd.js",
    "harness": "./scrapgrid"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.11",
    "shadcn": "^4.16.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
